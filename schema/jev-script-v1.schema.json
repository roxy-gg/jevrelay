{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jevrelay.com/schemas/jev-script-v1.schema.json",
  "title": "Jev Script v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "permissions", "steps"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origins"],
      "properties": {
        "origins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https?://[^/]+$"
          }
        }
      }
    },
    "inputs": { "type": "object" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/goto" },
          { "$ref": "#/$defs/fill" },
          { "$ref": "#/$defs/press" },
          { "$ref": "#/$defs/click" },
          { "$ref": "#/$defs/wait" },
          { "$ref": "#/$defs/extract" },
          { "$ref": "#/$defs/assert" },
          { "$ref": "#/$defs/decision" }
        ]
      }
    }
  },
  "$defs": {
    "variableName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["selector"],
          "properties": { "selector": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": {
            "role": { "type": "string", "minLength": 1 },
            "name": { "type": "string" },
            "exact": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "exact": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": { "id": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "goto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "url"],
      "properties": {
        "action": { "const": "browser.goto" },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target", "value"],
      "properties": {
        "action": { "const": "browser.fill" },
        "target": { "$ref": "#/$defs/target" },
        "value": { "type": "string" }
      }
    },
    "press": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target", "key"],
      "properties": {
        "action": { "const": "browser.press" },
        "target": { "$ref": "#/$defs/target" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "click": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target"],
      "properties": {
        "action": { "const": "browser.click" },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "wait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "const": "browser.wait" },
        "target": { "$ref": "#/$defs/target" },
        "state": { "enum": ["visible", "hidden", "attached", "detached"] },
        "milliseconds": { "type": "integer", "minimum": 0, "maximum": 30000 },
        "timeout": { "type": "integer", "minimum": 1, "maximum": 30000 }
      },
      "anyOf": [
        {
          "required": ["target"],
          "properties": { "target": {} }
        },
        {
          "required": ["milliseconds"],
          "properties": { "milliseconds": {} }
        }
      ]
    },
    "extract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target", "fields", "saveAs"],
      "properties": {
        "action": { "const": "browser.extract" },
        "target": { "$ref": "#/$defs/target" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "saveAs": { "$ref": "#/$defs/variableName" }
      }
    },
    "assert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target", "state"],
      "properties": {
        "action": { "const": "browser.assert" },
        "target": { "$ref": "#/$defs/target" },
        "state": { "enum": ["visible", "hidden", "attached", "playing"] },
        "timeout": { "type": "integer", "minimum": 1, "maximum": 30000 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decide"],
      "properties": {
        "decide": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "question", "saveAs"],
          "properties": {
            "state": {},
            "question": { "type": "string", "minLength": 1 },
            "options": {
              "type": "object",
              "minProperties": 2,
              "maxProperties": 255,
              "additionalProperties": { "type": ["string", "null"] }
            },
            "optionsFrom": { "type": "string", "minLength": 1 },
            "minimumConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "saveAs": { "$ref": "#/$defs/variableName" }
          },
          "oneOf": [
            {
              "required": ["options"],
              "properties": { "options": {} }
            },
            {
              "required": ["optionsFrom"],
              "properties": { "optionsFrom": {} }
            }
          ]
        }
      }
    }
  }
}
